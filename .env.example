# Live Show Radar - TEMPLATE. Copy to .env.local and fill in. Never put real values here.


# Supabase (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://tvaoqaddqoxrrgpcswsn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side only (the "secret" key, sb_secret_...). Needed for the scheduler/backend jobs.
SUPABASE_SECRET_KEY=

# Ticketmaster Discovery API (https://developer.ticketmaster.com/)
TICKETMASTER_API_KEY=

# Gemini (only for ambiguous artist matching)
GEMINI_API_KEY=


# Telegram (outbound alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Resend email
RESEND_API_KEY=
ALERT_FROM_EMAIL=

# Protects scheduled endpoints. Any long random string you make up.
CRON_SECRET=

# Comma-separated emails allowed to use the owner review screen
ADMIN_EMAILS=

# Local testing only (never set on Vercel): skips the login on your own computer
LOCAL_OWNER_MODE=

# Where owner alert emails go (with Resend's free test sender: your own Resend account email)
ALERT_TO_EMAIL=
# Public https URL of the deployed app (links inside alerts)
APP_BASE_URL=

# Send alerts right after you verify something in Review (set false to turn off)
AUTO_DISPATCH_ON_REVIEW=
# Master switch for all Telegram/email alerts (set false to pause)
NOTIFICATIONS_ENABLED=

# Scheduler tuning (optional)
DISCOVERY_ARTISTS_PER_RUN=
DISCOVERY_CORROBORATE_PER_RUN=
GEMINI_MODEL=
